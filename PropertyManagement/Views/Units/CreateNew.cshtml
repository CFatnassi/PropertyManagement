@model PropertyManagement.ViewModels.UnitView

@{

}

<style>
    .modal-header {
        background-color: #3ea7ed !important;
    }

    .modal-title {
        color: white !important;
    }

    .close {
        color: white !important;
    }
</style>


<div id="myModal" class="modal fade in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">

                <h5 class="modal-title" id="myModalLabel">

                    @Resources.Resource.AddNew

                </h5>
            </div>
            <div class="modal-body">


                @Html.ValidationSummary(true, "Please Fix The Foloing Error!")



                <div class="form-group">
                    @Html.LabelFor(m => m.FUnitKindId)  <strong class="text-danger">*</strong>

                    @Html.DropDownListFor(m => m.FUnitKindId, new SelectList(Model.UnitKinds, "Code", "ArName"), Resources.Resource.PlsSelectUnitKind, new { @id = "FUnitKindId", @class = "form-select" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.FRealEstGuid)  <strong class="text-danger">*</strong>

                    @Html.DropDownListFor(m => m.FRealEstGuid, new SelectList(Model.RealEstates, "Guid", "Location"), Resources.Resource.PlsSelectRealEstate, new { @id = "FRealEstGuid", @class = "form-select" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.NickName)*
                    @Html.TextBoxFor(m => m.NickName, new { @id = "NickName", @class = "form-control"})
                    @Html.ValidationMessageFor(m => m.NickName)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.AreaSize)*
                    @Html.TextBoxFor(m => m.AreaSize, new { @id = "AreaSize", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AreaSize)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Room)
                    @Html.TextBoxFor(m => m.Room, new { @id = "Room", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Room)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Bathroom)
                    @Html.TextBoxFor(m => m.Bathroom, new { @id = "Bathroom", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Bathroom)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Kitchen)
                    @Html.TextBoxFor(m => m.Kitchen, new { @id = "Kitchen", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Kitchen)
                </div>
            </div>
            <div class="modal-footer">



                <button type="submit" class="waves-effect waves-light btn btn-info mb-5 fa fa-pencil add-new" id="save"> @Resources.Resource.Save </button>


                <button type="button" class="waves-effect waves-light btn btn-default mb-5 fa fa-power-off" data-bs-dismiss="modal">  @Resources.Resource.Close</button>

            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>












