@model PropertyManagement.Models.Units
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
     
}


<div class="panel panel-primary card-view">
    <div class="panel-heading box rounded-3 bg-gradient-secondary">
        <div class="pull-left">
            <h6 class="panel-title fw-bold fs-20 text-white"><i class="fa fa-institution"></i>   @Resources.Resource.Unit</h6>
        </div>
        <div class="clearfix"></div>
    </div>
    <div class="panel-wrapper ">
        <div class="panel-body">

            <div class="col-lg-12">

                <a class="waves-effect waves-light btn btn-primary mb-5" id="js-addnew" href="/Units/CreateNew">
                    <i class="ti-save"></i>
                    @Resources.Resource.NewUnit
                </a>






            </div>
            <table id="tdataTable" class="table table-bordered table-striped dataTable" width="100%">
                <thead class="bg-primary">
                    <tr>
                        <th class="Font">@Resources.Resource.FUnitKindId</th>
                     
						<th class="Font">@Resources.Resource.NickName</th>

                        <th class="Font">@Resources.Resource.AreaSize</th>
                        <th class="Font">@Resources.Resource.Room</th>
                        <th class="Font">@Resources.Resource.Bathroom</th>

                        <th class="Font">@Resources.Resource.Kitchen</th>
                        <th class="Font">@Resources.Resource.Modify</th>
                        <th class="Font">@Resources.Resource.Delete</th>


                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>


    </div>
</div>

<div id="myModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true"> </div>
@section scripts{
    @Scripts.Render("~/bundles/jqueryval");
    <script>
	$(document).ready(function () {
		var tabelMemRef = $("#tdataTable").DataTable({
           processing: true,
            "language": {
                "emptyTable": '@Resources.Resource.EmptyTable',
                "search": '@Resources.Resource.Search',
                'loadingRecords': '&nbsp;',
                'processing': '<div class="row h-p100 align-items-center justify-content-center text-center"> <div class="rounded30 p-50"> <h1 class="fs-50 fw-bold error-page-title"> <i class="fa fa-spinner fa-spin"></i></h1> <i class="text-nowrap">@Resources.Resource.DataUnderProcessing</i> </div></div>',
                "zeroRecords": '@Resources.Resource.ZeroRecords',
                "info": '@Resources.Resource.Info',
                "infoEmpty": '@Resources.Resource.InfoEmpty',
                "lengthMenu": '@Resources.Resource.LengthMenu',
                "infoFiltered": '@Resources.Resource.InfoFiltered',
                "paginate": {
                    "previous": '@Resources.Resource.Previous',
                    "next": '@Resources.Resource.Next',
                    "first": '@Resources.Resource.First',
                    "last": '@Resources.Resource.Last',
                },
                "aria": {
                    "sortAscending": '@Resources.Resource.SortAscending',
                    "sortDescending": '@Resources.Resource.SortDescending'
                }
            },
                "scrollY": "500px",
                "scrollX": true,
                "bDeferRender": true,
                "paging": true,
                "processing": true,
                "searching": true,
                "ordering": false,
                "order": [[0, "asc"]],
                "scrollCollapse": true,

            "bInfo": false,
            dom: 'Bfrtip',
            buttons: [
                { extend: 'copy', className: 'btn btn-primary btn-sm' },
                { extend: 'excel', className: 'btn btn-primary btn-sm' },
                { extend: 'csv', className: 'btn btn-primary btn-sm' },
                { extend: 'print', className: 'btn btn-warning btn-sm' }
            ],
                ajax: {
                    url: "/Units/GetUnits",
					dataSrc: ""
				},
				columns: [
					{

                        data:"FUnitKindId"
                    },

                    

                    {
                        data: "NickName"

                    },
                    {

                        data:"AreaSize"
                    },

                    {
                        data: "Room"

                    },

                    {
                        data: "Bathroom"

                    },
                    {
                        data: "Kitchen"

                    },


                    {
                        data: "Guid",
                        render: function (data, type, r) {


                            return "<button  class='waves-effect waves-light btn btn-info mb-5 js-modify btn-sm' href='/Units/Modify/" + data + "'> <i class='ti-slice'></i></button>";


                        }
                    },


                    {
                        data: "Guid",
                        render: function (data) {


                            return "<button  class='btn  btn-icon-anim btn btn-danger js-modify btn-danger btn-sm' href='/Units/Remove/" + data + "'> <i class='fa fa-trash-o'></i></button>";

                        }

                    }


                ]
                //initComplete: function (settings, json) {
                //    var api = new $.fn.dataTable.Api(settings);



                //}


            });



        $('#tdataTable').on('click', '.js-delete', function (e) {
            var dialog = bootbox.dialog({
                    title: '@Resources.Resource.PleaseWait',
                    message: '<p><i class="fa fa-spin fa-spinner"></i> @Resources.Resource.PleaseWait...</p>',
                    closeButton: false
                });
                e.preventDefault();

                $('#myModal').modal('hide');
                $('#myModal').unbind().modal();
                url = this.getAttribute('href');
                $.get(url, function (data) {
                    $('#myModal').replaceWith(data);

                    $('#myModal').modal('toggle');
                    setTimeout(function () { dialog.modal('hide'); }, 1000);
                });
        });

        $('#tdataTable').on('click', '.js-modify', function (e) {
            var dialog = bootbox.dialog({
                    title: '@Resources.Resource.PleaseWait',
                    message: '<p><i class="fa fa-spin fa-spinner"></i> @Resources.Resource.PleaseWait...</p>',
                    closeButton: false
                });
                e.preventDefault();

                $('#myModal').modal('hide');
                $('#myModal').unbind().modal();
                url = this.getAttribute('href');
                $.get(url, function (data) {
                    $('#myModal').replaceWith(data);

                    $('#myModal').modal('toggle');
                    setTimeout(function () { dialog.modal('hide'); }, 1000);
                });
        });

        $('#js-addnew').on('click', function (e) {
            var dialog = bootbox.dialog({
                    title: '@Resources.Resource.PleaseWait',
                    message: '<p><i class="fa fa-spin fa-spinner"></i> @Resources.Resource.PleaseWait...</p>',
                    closeButton: false
                });
                e.preventDefault();

                $('#myModal').modal('hide');
                $('#myModal').unbind().modal();
                url = this.getAttribute('href');
                $.get(url, function (data) {
                    $('#myModal').replaceWith(data);

                    $('#myModal').modal('toggle');
                    setTimeout(function () { dialog.modal('hide'); }, 1000);
                });
        });

            // Attach listener to .modal-close-btn's so that when the button is pressed the modal dialog disappears
        $('#tdataTable').on('click', '.modal-close-btn', function () {
                $('#myModal').modal('hide');
            });
            //clear modal cache, so that new content can be loaded
         $('#myModal').on('hidden.bs.modal', function () {
                $(this).removeData('bs.modal');

            });

         $('#CancelModal').on('click', function (e) {             e.preventDefault();
                return false;
            });

        $(document).on('click', '#save', function (e) {
            e.preventDefault();

            if (($("#FUnitKindId").val() == '') || ($("#Guid").val() == '') || ($("#NickName").val() == '') || ($("#AreaSize").val() == '') || ($("#Room").val() == '') || ($("#Bathroom").val() == '') || ($("#Kitchen").val() == ''))  {
                    bootbox.alert({
                        message: '@Resources.Resource.PleasefillalRequiredfields',
                        size: 'small'
                    });

                }
                else {


                var dialog = bootbox.dialog({
                    title: '@Resources.Resource.PleaseWait',
                    message: '<p><i class="fa fa-spin fa-spinner"></i> @Resources.Resource.Saving...</p>',
                    closeButton: false
                });


				var dataToSave = {
                    
                    UnitKind: $("#FUnitKindId").val(), Guid: $("#Guid").val(), NickName: $("#NickName").val(), AreaSize: $("#AreaSize").val(), Room: $("#Room").val(), Bathroom: $("#Bathroom").val(), Kitchen: $("#Kitchen").val()
                };
                $.ajax({
                    type: "POST",
                    url: "/Units/SaveNew",
                    data: JSON.stringify(dataToSave),
                    contentType: 'application/json',
                    success: function (data) {
                        setTimeout(function () {                            dialog.modal('hide');                         }, 1000);
                        if (data.Code == 0) {
                            toastr.error(data.Msg);
                        }
                        else if (data.Code == 1) {
                            $('#myModal').modal('hide');
                            toastr.success(data.Msg);
                            tabelMemRef.ajax.reload();
                         ;
                        }

                    },
                    error: function (data) {
                        setTimeout(function () {                            dialog.modal('hide');                         }, 1000);
                        toastr.error(data);
                    }



                    });

                }

            });

        $(document).on('click', '#update', function (e) {
            e.preventDefault();
            if (($("#FUnitKindId").val() == '') || ($("#Guid").val() == '') || ($("#NickName").val() == '') || ($("#AreaSize").val() == '') || ($("#Room").val() == '') || ($("#Bathroom").val() == '') || ($("#Kitchen").val() == ''))  {
                    bootbox.alert({
                        message: '@Resources.Resource.PleasefillalRequiredfields',
                        size: 'small'
                    });

                }
                else {


                var dialog = bootbox.dialog({
                    title: '@Resources.Resource.PleaseWait',
                    message: '<p><i class="fa fa-spin fa-spinner"></i> @Resources.Resource.Saving...</p>',
                    closeButton: false
                });


                var dataToSave = {
                    UnitKind: $("#FUnitKindId").val(), Guid: $("#Guid").val(),
                    NickName: $("#NickName").val(), AreaSize: $("#AreaSize").val(), Room: $("#Room").val(), Bathroom: $("#Bathroom").val(), Kitchen: $("#Kitchen").val()
                };
                $.ajax({
                    type: "POST",
                    url: "/Units/Update",
                    data: JSON.stringify(dataToSave),
                    contentType: 'application/json',
                    success: function (data) {
                        setTimeout(function () {                            dialog.modal('hide');                         }, 1000);
                        if (data.Code == 0) {
                            toastr.error(data.Msg);
                        }
                        else if (data.Code == 1) {
                            $('#myModal').modal('hide');
                            toastr.success(data.Msg);
                            tabelMemRef.ajax.reload();

                        }

                    },
                    error: function (data) {
                        setTimeout(function () {                            dialog.modal('hide');                         }, 1000);
                        toastr.error(data);
                    }


                    });

                }

            });




        $(document).on('click', '#delete', function (e) {
            e.preventDefault();
            if (($("#FUnitKindId").val() == '') || ($("#Guid").val() == '') || ($("#NickName").val() == '') || ($("#AreaSize").val() == '') || ($("#Room").val() == '') || ($("#Bathroom").val() == '') || ($("#Kitchen").val() == ''))  {
                    bootbox.alert({
                        message: '@Resources.Resource.PleasefillalRequiredfields',
                        size: 'small'
                    });

                }
                else {


                var dialog = bootbox.dialog({
                    title: '@Resources.Resource.Deleting',
                    message: '<p><i class="fa fa-spin fa-spinner"></i> @Resources.Resource.Deleting...</p>',
                    closeButton: false
                });


                var dataToSave = {
                    UnitKind: $("#FUnitKindId").val(), Guid: $("#Guid").val(),
                    NickName: $("#NickName").val(), AreaSize: $("#AreaSize").val(), Room: $("#Room").val(), Bathroom: $("#Bathroom").val(), Kitchen: $("#Kitchen").val()
                };
                $.ajax({
                    type: "POST",
                    url: "/Units/Delete",
                    data: JSON.stringify(dataToSave),
                    contentType: 'application/json',
                    success: function (data) {
                        setTimeout(function () {                            dialog.modal('hide');                         }, 1000);
                        if (data.Code == 0) {
                            toastr.error(data.Msg);
                        }
                        else if (data.Code == 1) {
                            $('#myModal').modal('hide');
                            toastr.success(data.Msg);
                            tabelMemRef.ajax.reload();

                        }

                    },
                    error: function (data) {
                        setTimeout(function () {                            dialog.modal('hide');                         }, 1000);
                        toastr.error(data);
                    }


                    });

                }

            });

    });


</script>


}


