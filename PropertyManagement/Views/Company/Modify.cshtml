@model PropertyManagement.Models.Company
@{

}

<style>
    .modal-header {
        background-color: #3ea7ed !important;
    }

    .modal-title {
        color: white !important;
    }

    .close {
        color: white !important;
    }
</style>


<div id="myModal" class="modal fade in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">

                <h5 class="modal-title" id="myModalLabel">
                    @Resources.Resource.Modify

                </h5>
            </div>
            <div class="modal-body">


                @Html.ValidationSummary(true, "Please Fix The Foloing Error!")

                <div class="form-group">
                    @Html.LabelFor(m => m.Id)*
                    @Html.TextBoxFor(m => m.Id, new { @id = "Id", @class = "form-control", @min = "1", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.Id)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Name)*
                    @Html.TextBoxFor(m => m.Name, new { @id = "Name", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Email)*
                    @Html.TextBoxFor(m => m.Email, new { @id = "Email", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Email)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Adress)
                    @Html.TextBoxFor(m => m.Adress, new { @id = "Adress", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Adress)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Guid)*
                    @Html.TextBoxFor(m => m.Guid, new { @id = "Guid", @class = "form-control"})
                    @Html.ValidationMessageFor(m => m.Guid)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Status)*
                    @Html.TextBoxFor(m => m.Status, new { @id = "Status", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Status)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Logo)
                    @Html.TextBoxFor(m => m.Logo, new { @id = "Logo", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Logo)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Country)
                    @Html.TextBoxFor(m => m.Country, new { @id = "Country", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Country)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.UserId)
                    @Html.TextBoxFor(m => m.UserId, new { @id = "UserId", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.UserId)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CreateDate)
                    @Html.TextBoxFor(m => m.CreateDate, new { @id = "CreateDate", @class = "form-control", @type = "DateTime" })
                    @Html.ValidationMessageFor(m => m.CreateDate)
                </div>
            </div>
            <div class="modal-footer">



                <button type="submit" class="waves-effect waves-light btn btn-info mb-5 fa fa-pencil add-new" id="update"> @Resources.Resource.Save </button>


                <button type="button" class="waves-effect waves-light btn btn-default mb-5 fa fa-power-off" data-bs-dismiss="modal">  @Resources.Resource.Close</button>

            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>















