@model PropertyManagement.Models.RealEstate
@{

}

<style>
    .modal-header {
        background-color: #3ea7ed !important;
    }

    .modal-title {
        color: white !important;
    }

    .close {
        color: white !important;
    }
</style>


<div id="myModal" class="modal fade in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">

                <h5 class="modal-title" id="myModalLabel">
                    @Resources.Resource.Delete

                </h5>
            </div>
            <div class="modal-body">


                @Html.ValidationSummary(true, "Please Fix The Foloing Error!")

                <div class="form-group">
                    @Html.LabelFor(m => m.FREKId)*
                    @Html.TextBoxFor(m => m.FREKId, new { @id = "FREKId", @class = "form-control", @type = "number", @min = "1" })
                    @Html.ValidationMessageFor(m => m.FREKId)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Guid)*
                    @Html.TextBoxFor(m => m.Guid, new { @id = "Guid", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Guid)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.CoGuid)
                    @Html.TextBoxFor(m => m.CoGuid, new { @id = "CoGuid", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CoGuid)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.UnitCount)*
                    @Html.TextBoxFor(m => m.UnitCount, new { @id = "UnitCount", @class = "form-control", @type = "number", @min = "1" })
                    @Html.ValidationMessageFor(m => m.UnitCount)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Location)*
                    @Html.TextBoxFor(m => m.Location, new { @id = "Location", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Location)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Code)
                    @Html.TextBoxFor(m => m.Code, new { @id = "Code", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Code)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Details)
                    @Html.TextBoxFor(m => m.Details, new { @id = "Details", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Details)
                </div>
            </div>
            <div class="modal-footer">



                <button type="submit" class="waves-effect waves-light btn btn-info mb-5 fa fa-pencil add-new" id="delete"> @Resources.Resource.Delete </button>


                <button type="button" class="waves-effect waves-light btn btn-default mb-5 fa fa-power-off" data-bs-dismiss="modal">  @Resources.Resource.Close</button>

            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>













